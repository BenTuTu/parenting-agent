### 流式输出（SSE）：-N 关闭 curl 缓冲，逐 token 打印 data 行
curl -N -X POST http://localhost:3000/api/agent/chat \
  -H "Content-Type: application/json" \
  -d '{
    "sessionId": "user-002",
    "message": "该不该给宝宝用安抚奶嘴？",
    "stream": true
  }'


### 流式 + 只看拼接后的文本（需要 python3）
curl -sN -X POST http://localhost:3000/api/agent/chat \
  -H "Content-Type: application/json" \
  -d '{
    "sessionId": "user-002",
    "message": "那多大要戒掉？",
    "stream": true
  }' | python3 -u -c '
import sys, json
for line in sys.stdin:
    line = line.strip()
    if line.startswith("data: "):
        event = json.loads(line[6:])
        if "delta" in event:
            print(event["delta"], end="", flush=True)
        elif event.get("done"):
            print()
'